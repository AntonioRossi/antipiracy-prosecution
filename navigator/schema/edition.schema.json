{
  "schemaVersion": "1",
  "type": "object",
  "required": [
    "editionVersion",
    "editionId",
    "displayName",
    "strategyName",
    "strategyPrefix",
    "consumerId",
    "claimPackageId",
    "claimSetVersion",
    "relationPath",
    "editionWordingPath",
    "artifactName",
    "declaredReleaseTimestamp",
    "independentClaims",
    "census",
    "groups"
  ],
  "additionalProperties": false,
  "properties": {
    "editionVersion": {"type": "string", "enum": ["2"]},
    "editionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "displayName": {"type": "string", "minLength": 1},
    "strategyName": {"type": "string", "minLength": 1},
    "strategyPrefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$"},
    "consumerId": {"type": "string", "pattern": "^navigator-[a-z][a-z0-9-]{0,31}$"},
    "claimPackageId": {"type": "string", "pattern": "^aa11393us-[a-z][a-z0-9-]{0,31}-us-claim-set$"},
    "claimSetVersion": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[1-9][0-9]*$"},
    "relationPath": {"type": "string", "pattern": "^navigator/relations/[a-z][a-z0-9-]{0,31}__pct[.]relations[.]xml$"},
    "editionWordingPath": {"type": "string", "pattern": "^navigator/wording/[a-z][a-z0-9-]{0,31}[.]wording[.]xml$"},
    "artifactName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*[.]html$"},
    "declaredReleaseTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "independentClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "census": {
      "type": "object",
      "required": ["claims", "units"],
      "additionalProperties": false,
      "properties": {
        "claims": {"type": "integer", "minimum": 1},
        "units": {"type": "integer", "minimum": 1}
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
